{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lc-json.org/1.0-rc.3/sentence-transformation.schema.json",
  "title": "SentenceTransformation Question Schema",
  "description": "Cambridge exam-style controlled paraphrase tasks (FCE/CAE Use of English Part 4 - Key Word Transformation)",
  "type": "object",
  "allOf": [
    {
      "$ref": "question-base.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "sentenceTransformation"
        },
        "promptSentence": {
          "type": "string",
          "description": "Original sentence to transform",
          "minLength": 1
        },
        "keyword": {
          "type": "string",
          "description": "Word that MUST be used (uppercase)",
          "minLength": 1
        },
        "targetSentence": {
          "type": "string",
          "description": "Template with @@@ for answer chunks",
          "pattern": "@@@",
          "minLength": 4
        },
        "allOrNothing": {
          "type": "boolean",
          "description": "All chunks correct or zero points",
          "default": false
        },
        "acceptedChunks": {
          "type": "object",
          "description": "Dictionary: chunk index (as string) → array of accepted answers",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        },
        "chunkCaseSensitive": {
          "type": [
            "object",
            "null"
          ],
          "description": "Dictionary: chunk index → boolean (default: false)",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "boolean"
            }
          },
          "default": null
        },
        "chunkFeedback": {
          "type": [
            "object",
            "null"
          ],
          "description": "Dictionary: chunk index → feedback string",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "string"
            }
          },
          "default": null
        }
      },
      "required": [
        "promptSentence",
        "keyword",
        "targetSentence",
        "acceptedChunks"
      ]
    }
  ]
}
