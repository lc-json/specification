          "title": "Lesson 1.1: All four combinations",
          "sequence": 1,
          "items": [
            {
              "type": "exercise",
              "globalId": "25252525-1111-4111-8111-000000000003",
              "title": "Graded exercise",
              "sequence": 1,
              "instructions": "Graded homework: this score counts toward your grade.",
