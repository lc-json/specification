              "questions": [
                {
                  "type": "trueFalseQuestion",
                  "globalId": "25252525-1111-4111-8111-000000000008",
                  "title": "Graded quiz question",
                  "points": 1.0,
                  "prompt": "Quizzes are graded by default per the quiz-item schema.",
                  "correctAnswer": true,
                  "feedback": { "correct": "Right.", "incorrect": "isGraded defaults to true on quizzes." }
