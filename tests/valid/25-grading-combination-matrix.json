                  "feedback": { "correct": "Correct.", "incorrect": "isGraded defaults to false on exercises." }
                }
              ]
            },
            {
              "type": "quiz",
              "globalId": "25252525-1111-4111-8111-000000000007",
              "title": "Graded quiz",
              "sequence": 3,
              "instructions": "End-of-lesson assessment.",
