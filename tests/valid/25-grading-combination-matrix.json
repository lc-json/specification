                  "type": "trueFalseQuestion",
                  "globalId": "25252525-1111-4111-8111-000000000010",
                  "title": "Ungraded quiz question",
                  "points": 1.0,
                  "prompt": "A quiz with isGraded false is a valid combination (e.g. a diagnostic pre-test).",
                  "correctAnswer": true,
                  "feedback": { "correct": "Yes — grading is policy, item type is structure.", "incorrect": "It is valid — grading is policy, item type is structure." }
