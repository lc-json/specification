              "questions": [
                {
                  "type": "trueFalseQuestion",
                  "globalId": "25252525-1111-4111-8111-000000000004",
                  "title": "Graded exercise question",
                  "points": 1.0,
                  "prompt": "An exercise MAY contribute to the gradebook when isGraded is true.",
